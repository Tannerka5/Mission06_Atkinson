@model Mission06_Atkinson.Models.ViewModels.MovieFormViewModel

@{
    ViewData["Title"] = "Add New Movie";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h2 class="mb-0">Add New Movie</h2>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Movie.Title" class="form-label"></label>
                            <input asp-for="Movie.Title" class="form-control" />
                            <span asp-validation-for="Movie.Title" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Movie.CategoryId" class="form-label">Category</label>
                            <select asp-for="Movie.CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Movie.CategoryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Movie.Year" class="form-label"></label>
                            <input asp-for="Movie.Year" type="number" class="form-control" min="1888" />
                            <span asp-validation-for="Movie.Year" class="text-danger"></span>
                            <small class="form-text text-muted">Must be 1888 or later</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Movie.Director" class="form-label"></label>
                            <input asp-for="Movie.Director" class="form-control" placeholder="Optional" />
                            <span asp-validation-for="Movie.Director" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Movie.Rating" class="form-label"></label>
                            <select asp-for="Movie.Rating" asp-items="Model.Ratings" class="form-select">
                                <option value="">-- Select Rating --</option>
                            </select>
                            <span asp-validation-for="Movie.Rating" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Movie.LentTo" class="form-label"></label>
                            <input asp-for="Movie.LentTo" class="form-control" placeholder="Optional" />
                            <span asp-validation-for="Movie.LentTo" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Movie.Notes" class="form-label"></label>
                        <input asp-for="Movie.Notes" class="form-control" placeholder="Optional" />
                        <span asp-validation-for="Movie.Notes" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input asp-for="Movie.EditedCheckbox" type="checkbox" class="form-check-input" />
                                <label asp-for="Movie.EditedCheckbox" class="form-check-label">Edited</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input asp-for="Movie.CopiedToPlexCheckbox" type="checkbox" class="form-check-input" />
                                <label asp-for="Movie.CopiedToPlexCheckbox" class="form-check-label">Copied to Plex</label>
                            </div>
                        </div>
                    </div>


                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Add Movie</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
