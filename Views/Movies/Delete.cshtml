@model Mission06_Atkinson.Models.ViewModels.MovieDisplayItem

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h2 class="mb-0">Delete Movie</h2>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>Warning!</strong> Are you sure you want to delete this movie?
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Title:</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    <dt class="col-sm-3">Category:</dt>
                    <dd class="col-sm-9">@Model.Category</dd>

                    <dt class="col-sm-3">Year:</dt>
                    <dd class="col-sm-9">@Model.Year</dd>

                    <dt class="col-sm-3">Director:</dt>
                    <dd class="col-sm-9">@Model.Director</dd>

                    <dt class="col-sm-3">Rating:</dt>
                    <dd class="col-sm-9">@Model.Rating</dd>

                    <dt class="col-sm-3">Edited:</dt>
                    <dd class="col-sm-9">@(Model.Edited ? "Yes" : "No")</dd>

                    <dt class="col-sm-3">Copied to Plex:</dt>
                    <dd class="col-sm-9">@(Model.CopiedToPlex ? "Yes" : "No")</dd>

                    @if (!string.IsNullOrEmpty(Model.LentTo))
                    {
                        <dt class="col-sm-3">Lent To:</dt>
                        <dd class="col-sm-9">@Model.LentTo</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt class="col-sm-3">Notes:</dt>
                        <dd class="col-sm-9">@Model.Notes</dd>
                    }
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="MovieId" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Delete Movie</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
