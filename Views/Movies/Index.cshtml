@model Mission06_Atkinson.Models.ViewModels.MovieListViewModel

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="movies-page">
    <h1 class="text-center mb-4">Movie Collection</h1>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" name="searchTerm" value="@Model.SearchTerm"
                               placeholder="Search by title or director..." class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <select name="categoryFilter" class="form-select">
                            <option value="">All Categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryName" selected="@(category.CategoryName == Model.CategoryFilter)">
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="ratingFilter" class="form-select">
                            <option value="">All Ratings</option>
                            @foreach (var rating in Model.Ratings)
                            {
                                <option value="@rating" selected="@(rating == Model.RatingFilter)">@rating</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="sortBy" class="form-select">
                            <option value="">Sort by Title (A-Z)</option>
                            <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Title (Z-A)</option>
                            <option value="year" selected="@(Model.SortBy == "year")">Year (Oldest)</option>
                            <option value="year_desc" selected="@(Model.SortBy == "year_desc")">Year (Newest)</option>
                            <option value="category" selected="@(Model.SortBy == "category")">Category</option>
                            <option value="rating" selected="@(Model.SortBy == "rating")">Rating</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-danger w-100">Apply Filters</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="text-center mb-3">
        <p class="fw-bold">Showing @Model.Movies.Count movie(s)</p>
    </div>

    <!-- Movies Table -->
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Year</th>
                    <th>Director</th>
                    <th>Rating</th>
                    <th>Edited</th>
                    <th>Copied to Plex</th>
                    <th>Lent To</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model.Movies)
                {
                    <tr>
                        <td>@movie.Title</td>
                        <td>@movie.Category</td>
                        <td>@movie.Year</td>
                        <td>@movie.Director</td>
                        <td><span class="badge bg-danger">@movie.Rating</span></td>
                        <td>@(movie.Edited ? "Yes" : "No")</td>
                        <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                        <td>@(string.IsNullOrEmpty(movie.LentTo) ? "-" : movie.LentTo)</td>
                        <td>@(string.IsNullOrEmpty(movie.Notes) ? "-" : movie.Notes)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-success">Edit</a>
                            <a asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Movies.Count == 0)
    {
        <div class="alert alert-info text-center">
            <p class="mb-0">No movies found. <a asp-action="Create" class="alert-link">Add your first movie</a>!</p>
        </div>
    }
</div>
