@model Mission06_Atkinson.Models.ViewModels.MovieListViewModel

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="movies-page">
    <h1 class="page-title">Movie Collection</h1>

    <div class="filter-section">
        <form asp-action="Index" method="get" class="filter-form">
            <div class="filter-row">
                <div class="form-group">
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by title or director..." class="form-control" />
                </div>
                <div class="form-group">
                    <select name="categoryFilter" class="form-control">
                        <option value="">All Categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryName" selected="@(category.CategoryName == Model.CategoryFilter)">@category.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <select name="ratingFilter" class="form-control">
                        <option value="">All Ratings</option>
                        @foreach (var rating in Model.Ratings)
                        {
                            <option value="@rating" selected="@(rating == Model.RatingFilter)">@rating</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <select name="sortBy" class="form-control">
                        <option value="">Sort by Title (A-Z)</option>
                        <option value="title_desc" selected="@(Model.SortBy == "title_desc")">Title (Z-A)</option>
                        <option value="year" selected="@(Model.SortBy == "year")">Year (Oldest)</option>
                        <option value="year_desc" selected="@(Model.SortBy == "year_desc")">Year (Newest)</option>
                        <option value="category" selected="@(Model.SortBy == "category")">Category</option>
                        <option value="rating" selected="@(Model.SortBy == "rating")">Rating</option>
                    </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Apply Filters</button>
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-secondary">Clear</a>
                </div>
            </div>
        </form>
    </div>

    <div class="movie-count">
        <p>Showing @Model.Movies.Count movie(s)</p>
    </div>

    <div class="table-responsive">
        <table class="movie-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Year</th>
                    <th>Director(s)</th>
                    <th>Rating</th>
                    <th>Edited</th>
                    <th>Lent To</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model.Movies)
                {
                    <tr>
                        <td>@movie.Title</td>
                        <td>@movie.Category</td>
                        <td>@movie.Year</td>
                        <td>@movie.Directors</td>
                        <td><span class="rating-badge">@movie.Rating</span></td>
                        <td>@(movie.Edited ? "Yes" : "No")</td>
                        <td>@(string.IsNullOrEmpty(movie.LentTo) ? "-" : movie.LentTo)</td>
                        <td>@(string.IsNullOrEmpty(movie.Notes) ? "-" : movie.Notes)</td>
                        <td class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-edit">Edit</a>
                            <a asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-sm btn-delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Movies.Count == 0)
    {
        <div class="no-movies">
            <p>No movies found. <a asp-action="Create">Add your first movie</a>!</p>
        </div>
    }
</div>
